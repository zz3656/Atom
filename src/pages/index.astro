---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import HeroIcon from '../components/HeroIcon.astro';
import { SITE_TITLE, SITE_DESCRIPTION, POSTS_PER_PAGE } from '../consts';
import { getPublishedPosts } from '../utils/collection';
import { blogPostUrl, rootPath, blogListUrl } from '../utils/path';
const allPosts = await getPublishedPosts();
const pagePosts = allPosts.slice(0, POSTS_PER_PAGE);

const totalPages = Math.ceil(allPosts.length / POSTS_PER_PAGE) || 1;
const totalPosts = allPosts.length;
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="hero">
    <h1>
      <HeroIcon />
      Atom 博客
    </h1>
    <p class="hero-desc">
      一个简洁、快速、优雅的现代博客。基于 Astro 构建，零 JavaScript， Lighthouse
      满分，为你的内容而生。
    </p>
    <div class="hero-actions">
      <a href={rootPath() + '/blog'} class="btn btn-primary">
        浏览文章 →
      </a>
      <a href={rootPath() + '/about'} class="btn btn-secondary">
        关于此博客
      </a>
    </div>
  </section>

  <section class="recent-posts">
    <div class="section-header">
      <h2 class="section-title">最新文章</h2>
      <span class="section-count">共 {totalPosts} 篇</span>
    </div>
    <ul class="post-grid">
      {pagePosts.map((post) => (
        <PostCard
          slug={blogPostUrl(post.id)}
          title={post.data.title}
          description={post.data.description}
          body={post.body}
          pubDate={post.data.pubDate}
          category={post.data.category}
          tags={post.data.tags}
        />
      ))}
    </ul>

    {totalPages > 1 && (
      <nav class="pagination" aria-label="文章分页">
        {pagePosts.length < allPosts.length && (
          <a href={blogListUrl()} class="page-btn next">
            更多文章 →
          </a>
        )}
      </nav>
    )}
  </section>
</BaseLayout>
