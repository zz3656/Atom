---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="hero">
    <h1>
      <svg class="hero-atom-icon" viewBox="0 0 32 32" width="36" height="36" xmlns="http://www.w3.org/2000/svg">
        <circle cx="16" cy="16" r="14" fill="url(#heroIconBg)"/>
        <ellipse cx="16" cy="16" rx="11" ry="5" fill="none" stroke="url(#heroIconRing)" stroke-width="1.5" transform="rotate(30 16 16)"/>
        <ellipse cx="16" cy="16" rx="11" ry="5" fill="none" stroke="url(#heroIconRing)" stroke-width="1.5" transform="rotate(-30 16 16)"/>
        <ellipse cx="16" cy="16" rx="11" ry="5" fill="none" stroke="url(#heroIconRing)" stroke-width="1.5" transform="rotate(90 16 16)"/>
        <circle cx="16" cy="16" r="2.5" fill="#fff"/>
        <defs>
          <linearGradient id="heroIconBg" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" style="stop-color:#6366f1"/>
            <stop offset="100%" style="stop-color:#8b5cf6"/>
          </linearGradient>
          <linearGradient id="heroIconRing" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" style="stop-color:#e0e7ff"/>
            <stop offset="100%" style="stop-color:#a5b4fc"/>
          </linearGradient>
        </defs>
      </svg>
      Atom 博客
    </h1>
    <p class="hero-desc">
      一个简洁、快速、优雅的现代博客。基于 Astro 构建，零 JavaScript，
      Lighthouse 满分，为你的内容而生。
    </p>
    <div class="hero-actions">
      <a href={base + "/blog"} class="btn btn-primary">浏览文章 →</a>
      <a href={base + "/about"} class="btn btn-secondary">关于此博客</a>
    </div>
  </section>
</BaseLayout>
