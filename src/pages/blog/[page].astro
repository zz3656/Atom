---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );
  const totalPosts = posts.length;
  const POSTS_PER_PAGE = 12;
  const totalPages = Math.ceil(totalPosts / POSTS_PER_PAGE) || 1;
  return Array.from({ length: totalPages }, (_, i) => ({
    params: { page: String(i + 1) },
    props: { page: i + 1 },
  }));
}

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const currentPage = Astro.props.page;
const POSTS_PER_PAGE = 12;
const totalPosts = posts.length;
const totalPages = Math.ceil(totalPosts / POSTS_PER_PAGE) || 1;
const displayPage = Math.min(currentPage, totalPages);
const startIndex = (displayPage - 1) * POSTS_PER_PAGE;
const currentPagePosts = posts.slice(startIndex, startIndex + POSTS_PER_PAGE);

const getPageUrl = (p: number) => {
  if (p <= 1) return base + '/blog/';
  return base + `/blog/${p}/`;
};
const pageNumbers: number[] = [];
for (let i = 1; i <= totalPages; i++) pageNumbers.push(i);
---

<BaseLayout title={`${displayPage === 1 ? '所有文章' : `所有文章 | 第${displayPage}页`}`} description="查看所有文章">
  <section class="blog-list">
    <div class="blog-list-header">
      <h1>📝 所有文章</h1>
      <p class="blog-count">共 {totalPosts} 篇</p>
    </div>
    <ul class="post-list">
      {currentPagePosts.map((post) => (
        <PostCard
          slug={base + "/blog/" + post.slug + "/"}
          title={post.data.title}
          pubDate={post.data.pubDate}
          description={post.data.description}
          category={post.data.category}
          tags={post.data.tags}
        />
      ))}
    </ul>

    {totalPages > 1 && (
      <nav class="pagination" aria-label="文章分页">
        {displayPage > 1 && (
          <a href={getPageUrl(displayPage - 1)} class="page-btn prev">← 上一页</a>
        )}
        <div class="page-numbers">
          {pageNumbers.map((p) => (
            <a
              href={getPageUrl(p)}
              class:list={['page-link', p === displayPage && 'active']}
              aria-label={p === displayPage ? '当前页' : `第 ${p} 页`}
              aria-current={p === displayPage ? 'page' : undefined}
            >{p}</a>
          ))}
        </div>
        {displayPage < totalPages && (
          <a href={getPageUrl(displayPage + 1)} class="page-btn next">下一页 →</a>
        )}
      </nav>
    )}
  </section>
</BaseLayout>
