---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Collect all unique categories
const categoryMap = new Map<string, typeof posts>();
posts.forEach((post) => {
  const cat = post.data.category || '未分类';
  if (!categoryMap.has(cat)) categoryMap.set(cat, []);
  categoryMap.get(cat)!.push(post);
});

const sortedCategories = [...categoryMap.entries()].sort((a, b) => b[1].length - a[1].length);
---

<BaseLayout title="所有分类 | Atom Blog">
  <section class="blog-list">
    <div class="blog-list-header">
      <h1>📁 所有分类</h1>
      <p class="blog-count">共 {sortedCategories.length} 个分类</p>
    </div>

    {sortedCategories.length > 0 ? (
      <div class="category-cloud">
        {sortedCategories.map(([category, catPosts]) => (
          <a href={`${base}category/${category}/`} class="category-item">
            <span class="category-name">📁 {category}</span>
            <span class="category-count">{catPosts.length}</span>
          </a>
        ))}
      </div>
    ) : (
      <p class="blog-count">暂无分类</p>
    )}
  </section>
</BaseLayout>
