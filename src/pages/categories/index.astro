---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { createCategoryFilter, normalizeCategory } from '../../utils/blog';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Collect all unique categories
const categoryMap = new Map<string, typeof posts>();
posts.forEach((post) => {
  const cat = normalizeCategory(post.data.category);
  if (!categoryMap.has(cat)) categoryMap.set(cat, []);
  categoryMap.get(cat)!.push(post);
});

const sortedCategories = [...categoryMap.entries()].sort((a, b) => b[1].length - a[1].length);
---

<BaseLayout title="所有分类 | Atom Blog">
  <section class="listing-page">
    <div class="unified-page-header">
      <h1>所有分类</h1>
      <p class="unified-page-subtitle">共 <span class="accent">{sortedCategories.length}</span> 个分类 · <span class="accent">{posts.length}</span> 篇文章</p>
    </div>

    {sortedCategories.length > 0 ? (
      <div class="category-grid">
        {sortedCategories.map(([category, catPosts]) => (
          <a href={`/category/${encodeURIComponent(category)}/`} class="category-card">
            <span class="category-card-name">📁 {category}</span>
            <span class="category-card-count">{catPosts.length}</span>
          </a>
        ))}
      </div>
    ) : (
      <p class="empty-state">暂无分类</p>
    )}
  </section>
</BaseLayout>
