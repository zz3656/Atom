---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Collect all unique tags
const tagMap = new Map<string, typeof posts>();
posts.forEach((post) => {
  (post.data.tags || []).forEach((tag) => {
    if (!tagMap.has(tag)) tagMap.set(tag, []);
    tagMap.get(tag)!.push(post);
  });
});

const sortedTags = [...tagMap.entries()].sort((a, b) => b[1].length - a[1].length);
---

<BaseLayout title="所有标签 | Atom Blog">
  <section class="blog-list">
    <div class="blog-list-header">
      <h1>🏷️ 所有标签</h1>
      <p class="blog-count">共 {sortedTags.length} 个标签</p>
    </div>

    {sortedTags.length > 0 ? (
      <div class="tag-cloud">
        {sortedTags.map(([tag, tagPosts]) => (
          <a href={`${base}/tag/${tag}/`} class="tag-item">
            <span class="tag-name">{tag}</span>
            <span class="tag-count">{tagPosts.length}</span>
          </a>
        ))}
      </div>
    ) : (
      <p class="blog-count">暂无标签</p>
    )}
  </section>
</BaseLayout>
