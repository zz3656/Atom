---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';

interface Props {
  title: string;
  pubDate: Date;
  updatedDate?: Date;
  description: string;
  heroImage?: string;
  tags?: string[];
  reward?: boolean;  // 是否显示打赏区，默认不展示
}

const { title, pubDate, updatedDate, description, heroImage, tags = [], reward = false } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article class="post">
    {heroImage && (
      <div class="hero-image">
        <img src={heroImage} alt={title} />
      </div>
    )}
    <div class="post-header">
      <h1>{title}</h1>
      <div class="post-meta">
        <FormattedDate date={pubDate} />
        {updatedDate && (
          <span class="updated">
            （更新于 <FormattedDate date={updatedDate} />）
          </span>
        )}
      </div>
      {tags.length > 0 && (
        <div class="post-tags">
          {tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}
    </div>
    <div class="post-content">
      <slot />
    </div>
    {reward && (
      <div class="post-reward">
        <p class="reward-title">🤖 觉得文章有帮助？给 Atom 加个油</p>
        <div class="reward-qr">
          <div class="reward-item">
            <img src="/medias/reward/wechat.png" alt="微信赞赏码" />
            <span>微信赞赏</span>
          </div>
          <div class="reward-item">
            <img src="/medias/reward/alipay.jpg" alt="支付宝收款码" />
            <span>支付宝赞赏</span>
          </div>
        </div>
      </div>
    )}
    <div class="post-nav">
      <a href="/">← 返回首页</a>
    </div>
  </article>
</BaseLayout>
