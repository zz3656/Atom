---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION, AUTHOR, SITE_FAVICON } from '../consts';
import { rssUrl, baseAssetsPath } from '../utils/path';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const { title, description, image, type = 'website' } = Astro.props;
const fullTitle = title;
const desc = description || SITE_DESCRIPTION;
const rssLink = rssUrl();
const faviconLink = baseAssetsPath(SITE_FAVICON);
const searchBase = baseAssetsPath('/');

// Site URL for OG/Twitter images and RSS
const siteUrl = String(Astro.site || '').replace(/\/$/, '');
const ogImage = image ? `${siteUrl}${image}` : `${siteUrl}/favicon.svg`;
---

<!doctype html>
<html lang="zh-CN" data-theme="atom-default" data-mode="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <!-- CSP & Security -->
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="description" content={desc} />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content={AUTHOR} />
    <meta name="theme-color" content="#6366f1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1e1b4b" media="(prefers-color-scheme: dark)" />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={SITE_TITLE} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />

    <!-- RSS Feed -->
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={rssLink} />

    <!-- OpenSearch -->
    <link
      rel="search"
      type="application/opensearchdescription+xml"
      href={baseAssetsPath('/opensearch.xml')}
      title={SITE_TITLE}
    />

    <link rel="icon" type="image/svg+xml" href={faviconLink} />

    <!-- PWA Manifest -->
    <link rel="manifest" href={baseAssetsPath('/manifest.json')} />

    <!-- Font preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&family=Noto+Serif+SC:wght@400;500;600;700&display=swap"
      rel="stylesheet"
      crossorigin="anonymous"
    />
    <title>{fullTitle}</title>
    <script is:inline>
      // Apply theme synchronously before page render to avoid FOUC
      // 多主题系统: localStorage.themeId (主题 ID) + localStorage.themeMode ('light'|'dark')
      (function () {
        var html = document.documentElement;
        var DEFAULT_ID = 'atom-default';
        var VALID_IDS = ['atom-default', 'solarized', 'sepia'];
        var id = localStorage.getItem('themeId');
        var mode = localStorage.getItem('themeMode');
        if (!id || VALID_IDS.indexOf(id) === -1) id = DEFAULT_ID;
        if (mode !== 'light' && mode !== 'dark') {
          mode = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        html.setAttribute('data-theme', id);
        html.setAttribute('data-mode', mode);
      })();
    </script>
    <slot name="head" />
  </head>
  <body data-search-base={searchBase}>
    <a class="skip-link" href="#main-content">
      跳到主要内容
    </a>
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <button id="back-to-top" class="back-to-top" aria-label="返回顶部" type="button">
      <svg
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <polyline points="18 15 12 9 6 15"></polyline>
      </svg>
    </button>
    <script src={baseAssetsPath('/js/app.js')} defer></script>
  </body>
</html>
