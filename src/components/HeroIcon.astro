---
// Atom 原子图标 — Hero 区域专用
// 复用了首页 README 的 Logo 风格，避免内联大段 SVG
interface Props {
  width?: number;
  height?: number;
  className?: string;
}

const { width = 36, height = 36, className = 'hero-atom-icon' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 32 32"
  width={width}
  height={height}
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <circle cx="16" cy="16" r="14" fill="url(#heroIconBg)" />
  <ellipse
    cx="16"
    cy="16"
    rx="11"
    ry="5"
    fill="none"
    stroke="url(#heroIconRing)"
    stroke-width="1.5"
    transform="rotate(30 16 16)"
  />
  <ellipse
    cx="16"
    cy="16"
    rx="11"
    ry="5"
    fill="none"
    stroke="url(#heroIconRing)"
    stroke-width="1.5"
    transform="rotate(-30 16 16)"
  />
  <ellipse
    cx="16"
    cy="16"
    rx="11"
    ry="5"
    fill="none"
    stroke="url(#heroIconRing)"
    stroke-width="1.5"
    transform="rotate(90 16 16)"
  />
  <circle cx="16" cy="16" r="2.5" fill="#fff" />
  <defs>
    <linearGradient id="heroIconBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#6366f1" />
      <stop offset="100%" style="stop-color:#8b5cf6" />
    </linearGradient>
    <linearGradient id="heroIconRing" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#e0e7ff" />
      <stop offset="100%" style="stop-color:#a5b4fc" />
    </linearGradient>
  </defs>
</svg>
