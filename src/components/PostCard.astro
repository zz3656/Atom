---
import { extractSummary } from '../utils/blog';
import { formatDateCN } from '../utils/date';

interface Props {
  slug: string;
  title: string;
  pubDate: Date;
  description?: string;
  category?: string;
  tags?: string[];
  index?: number | undefined;
  body?: string;
}

const { slug, title, pubDate, description, category = '', tags = [], body = '' } = Astro.props;
const idx = 'index' in Astro.props ? Astro.props.index : undefined;

// Auto-extract description from body if description is empty
const postDesc = description || extractSummary(body);
---

<li class="post-card">
  <a href={slug}>
    {idx != null && <div class="post-card-index">{String(idx + 1).padStart(2, '0')}</div>}
    <div class="post-card-body">
      <h2 class="post-card-title">{title}</h2>
      {postDesc && <p class="post-card-desc">{postDesc}</p>}
      <div class="post-card-meta">
        <div class="meta-top">
          <time datetime={pubDate.toISOString()} class="post-card-date">
            {formatDateCN(pubDate)}
          </time>
          {category && <span class="post-card-category">{category}</span>}
        </div>
        {tags.length > 0 && (
          <div class="post-card-tags">
            {tags.slice(0, 4).map((tag) => (
              <span class="tag">{tag}</span>
            ))}
            {tags.length > 4 && <span class="tag">+{tags.length - 4}</span>}
          </div>
        )}
      </div>
    </div>
  </a>
</li>
