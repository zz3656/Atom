---
import { SOCIAL_LINKS } from '../consts';
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
const rssUrl = base + '/rss.xml';
---

<footer class="site-footer">
  <div class="footer-content">
    <div class="footer-links">
      <a href={SOCIAL_LINKS.github} target="_blank" rel="noopener">🐙 GitHub</a>
      <a href={rssUrl} target="_blank" rel="noopener">📡 RSS</a>
      <a href={base + '/about'}>👤 关于</a>
    </div>
    <p>© {year} <a href={SOCIAL_LINKS.github} target="_blank" rel="noopener">Atom Blog</a>. Powered by <a href="https://astro.build" target="_blank" rel="noopener">Astro</a></p>
  </div>
</footer>
