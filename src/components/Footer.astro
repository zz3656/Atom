---
import { SITE_TITLE, REPO_URL, SOCIAL_LINKS } from '../consts';
import { rssUrl, aboutUrl } from '../utils/path';

const year = new Date().getFullYear();

// 个人社交链接（不包含 GitHub，因为 GitHub 已通过 REPO_URL 单独展示）
const socialLinks = [
  SOCIAL_LINKS.twitter
    ? { href: SOCIAL_LINKS.twitter, label: '🐦 Twitter', target: '_blank', rel: 'noopener' }
    : null,
  SOCIAL_LINKS.email ? { href: `mailto:${SOCIAL_LINKS.email}`, label: '✉️ Email' } : null,
].filter(Boolean);
---

<footer class="site-footer">
  <div class="footer-content">
    <div class="footer-links">
      <a href={REPO_URL} target="_blank" rel="noopener" title="项目源代码仓库">
        🐙 GitHub
      </a>
      {socialLinks.map(
        (link) =>
          link && (
            <a href={link.href} target={link.target || undefined} rel={link.rel || undefined}>
              {link.label}
            </a>
          ),
      )}
      <a href={rssUrl()} target="_blank" rel="noopener">
        📡 RSS
      </a>
      <a href={aboutUrl()}>👤 关于</a>
    </div>
    <p>
      © {year}{' '}
      <a href={REPO_URL} target="_blank" rel="noopener">
        {SITE_TITLE}
      </a>
      . Powered by{' '}
      <a href="https://astro.build" target="_blank" rel="noopener">
        Astro
      </a>
    </p>
  </div>
</footer>
