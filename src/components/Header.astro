---
import { SITE_TITLE, SITE_NAME, SITE_LOGO } from '../consts';
import { baseAssetsPath } from '../utils/path';

const logoSrc = baseAssetsPath(SITE_LOGO);

// Active path detection
const currentPath = Astro.url.pathname;

const navLinks = [
  { label: '首页', href: '/', active: currentPath === '/' || currentPath === baseAssetsPath('/') },
  { label: '文章', href: '/blog', active: currentPath === baseAssetsPath('/blog') || currentPath === baseAssetsPath('/blog/') || currentPath.startsWith('/blog/') },
  { label: '分类', href: '/categories', active: currentPath === baseAssetsPath('/categories') || currentPath === baseAssetsPath('/categories/') },
  { label: '标签', href: '/tags', active: currentPath === baseAssetsPath('/tags') || currentPath === baseAssetsPath('/tags/') },
  { label: '关于', href: '/about', active: currentPath === baseAssetsPath('/about') || currentPath === baseAssetsPath('/about/') },
];
---

<header class="site-header">
  <nav class="nav-container">
    <a href={baseAssetsPath('/')} class="site-title">
      <img src={logoSrc} alt="Logo" class="site-logo" />
      <span class="site-name-text">{SITE_NAME}</span>
    </a>

    <!-- Hamburger toggle button (mobile only) -->
    <button class="nav-toggle" id="nav-toggle" aria-label="切换菜单" aria-expanded="false">
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>

    <div class="nav-links" id="nav-links">
      {navLinks.map((link, i) => (
        <a href={baseAssetsPath(link.href)} class:list={['nav-link', link.active && 'active']}>{link.label}</a>
      ))}
    </div>
    <div class="nav-actions">
      <div class="search-wrapper">
        <input
          type="text"
          id="search-input"
          class="search-input"
          placeholder="搜索文章…"
          aria-label="搜索文章"
          autocomplete="off"
        />
        <div id="search-results" class="search-results"></div>
      </div>
      <div class="theme-toggle" id="theme-toggle" aria-label="切换暗黑模式" style="cursor:pointer;">🌙</div>
    </div>
  </nav>
</header>

<script is:inline>
  (function() {
    var toggle = document.getElementById('nav-toggle');
    var navLinks = document.getElementById('nav-links');
    if (!toggle || !navLinks) return;
    toggle.addEventListener('click', function() {
      var isOpen = navLinks.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(isOpen));
    });
    // 点击链接后关闭菜单
    navLinks.querySelectorAll('.nav-link').forEach(function(link) {
      link.addEventListener('click', function() {
        navLinks.classList.remove('open');
        toggle.setAttribute('aria-expanded', 'false');
      });
    });
  })();
</script>
