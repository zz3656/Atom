---
import { SITE_NAME, SITE_LOGO } from '../consts';
import { baseAssetsPath } from '../utils/path';
import { themes } from '../generated/themes';

const logoSrc = baseAssetsPath(SITE_LOGO);

// Active path detection
const currentPath = Astro.url.pathname;

const navLinks = [
  { label: '首页', href: '/', active: currentPath === '/' },
  {
    label: '文章',
    href: '/blog',
    active: currentPath === '/blog' || currentPath === '/blog/' || currentPath.startsWith('/blog/'),
  },
  {
    label: '分类',
    href: '/categories',
    active: currentPath === '/categories' || currentPath === '/categories/',
  },
  { label: '标签', href: '/tags', active: currentPath === '/tags' || currentPath === '/tags/' },
  { label: '关于', href: '/about', active: currentPath === '/about' || currentPath === '/about/' },
];
---

<header class="site-header">
  <nav class="nav-container">
    <a href={baseAssetsPath('/')} class="site-title">
      <img src={logoSrc} alt="Logo" class="site-logo" width="32" height="32" />
      <span class="site-name-text">{SITE_NAME}</span>
    </a>

    <!-- Hamburger toggle button (mobile only) -->
    <button class="nav-toggle" id="nav-toggle" aria-label="切换菜单" aria-expanded="false">
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>

    <div class="nav-links" id="nav-links">
      {navLinks.map((link) => (
        <a href={baseAssetsPath(link.href)} class:list={['nav-link', link.active && 'active']}>
          {link.label}
        </a>
      ))}
    </div>
    <div class="nav-actions">
      <div class="search-wrapper">
        <input
          type="text"
          id="search-input"
          class="search-input"
          placeholder="搜索文章…"
          aria-label="搜索文章"
          autocomplete="off"
          data-search-trigger
        />
        <div id="search-results" class="search-results"></div>
      </div>

      <!-- Theme picker (主题下拉) -->
      <div class="theme-picker" id="theme-picker">
        <button
          type="button"
          class="theme-toggle"
          id="theme-toggle"
          aria-label="切换主题"
          aria-haspopup="menu"
          aria-expanded="false"
          style="cursor:pointer;"
        >
          <span id="theme-toggle-icon">🌙</span>
        </button>
        <div class="theme-menu" id="theme-menu" role="menu" hidden>
          <div class="theme-menu-section">
            <div class="theme-menu-label">主题</div>
            {themes.map((theme) => (
              <button
                type="button"
                class="theme-option"
                role="menuitem"
                data-theme-id={theme.id}
                data-has-dark={theme.modes.includes('dark') ? '1' : '0'}
                title={theme.description}
              >
                <span class="theme-option-name">{theme.name}</span>
                {theme.modes.includes('dark')
                  ? <span class="theme-option-badge">双模式</span>
                  : <span class="theme-option-badge single">单模式</span>}
              </button>
            ))}
          </div>
          <div class="theme-menu-section" id="theme-mode-section">
            <div class="theme-menu-label">外观</div>
            <button type="button" class="theme-option" role="menuitem" data-mode="light">
              <span class="theme-option-name">☀ 浅色</span>
            </button>
            <button type="button" class="theme-option" role="menuitem" data-mode="dark">
              <span class="theme-option-name">🌙 深色</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </nav>
</header>